# GlobAQI local development environment template.
# This file contains safe placeholders only. Copy to .env and replace values
# only for integrations you plan to use. Never commit .env.

# App URLs and runtime
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Encryption for saved provider credentials and OAuth tokens.
# The API has an insecure development fallback; set a private, stable value
# before storing real credentials. The implementation hashes this string to
# derive its AES-256-GCM key.
ENCRYPTION_KEY=replace-with-a-private-random-secret

# Optional local AI. The API uses Ollama when available and has a local
# template fallback for caption generation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Reddit API user agent.
REDDIT_USER_AGENT="globaqi/0.1 by your-reddit-username"

# Optional platform app credentials. These are only needed if credentials
# are not entered for a workspace in the Settings page. Values are blank by
# default; callback support is implemented only for YouTube, Reddit, and X.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional local Docker Compose services. Replace these local-only placeholders
# before starting the services; do not reuse production credentials here.
POSTGRES_DB=globaqi_dev
POSTGRES_USER=globaqi_dev
POSTGRES_PASSWORD=replace-with-local-postgres-password
MINIO_ROOT_USER=globaqi_dev
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=replace-with-local-pgadmin-password

# Database tooling only. The API currently uses local JSON persistence and
# does not connect to PostgreSQL. DATABASE_URL is required by Drizzle config
# and database seed tooling if you choose to run those separate commands.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
